{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LiveDub Voice",
  "version": "0.1.0",
  "identifier": "io.github.fatuking.livedubvoice",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LiveDub Voice",
        "width": 1024,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Real-time voice translator for calls and games",
    "publisher": "LiveDub Voice contributors",
    "license": "MIT"
  },
  "mainBinaryName": "livedub-voice"
}
