{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LiveDub Voice",
  "version": "0.1.0",
  "identifier": "io.github.fatuking.livedubvoice",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LiveDub Voice",
        "width": 1024,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "LiveDub Voice contributors",
    "copyright": "Copyright (c) 2026 Facundo Cozzani. MIT License.",
    "license": "MIT",
    "homepage": "https://github.com/FatuKING/livedub-voice",
    "category": "Utility",
    "shortDescription": "Real-time voice translator for calls and games",
    "longDescription": "LiveDub Voice translates voice in real time for calls and games on Windows: you hear the other participants in your language, and they hear you in theirs through a virtual microphone. It uses OpenAI's gpt-realtime-translate model with your own API key.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Spanish"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "installerHooks": "installer/hooks.nsh"
      }
    }
  },
  "mainBinaryName": "livedub-voice"
}
